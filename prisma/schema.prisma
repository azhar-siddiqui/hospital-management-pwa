generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  ASSISTANT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  passwordSeal String?
  role         Role     @default(RECEPTIONIST)
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
